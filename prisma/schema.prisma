generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FARMER
  BUYER
  AGRONOMIST
  ADMIN
}

enum ListingStatus {
  ACTIVE
  SOLD_OUT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum DeviceType {
  SOIL_MOISTURE
  WEATHER_STATION
  TEMPERATURE_HUMIDITY
  WATER_LEVEL
  PH_SENSOR
  NPK_SENSOR
  RAIN_GAUGE
  WIND_SPEED
  LIGHT_SENSOR
  OTHER
}

enum ReadingType {
  SOIL_MOISTURE
  SOIL_TEMPERATURE
  SOIL_PH
  SOIL_NPK
  AIR_TEMPERATURE
  AIR_HUMIDITY
  RAINFALL
  WIND_SPEED
  LIGHT_INTENSITY
  WATER_LEVEL
  PRESSURE
  OTHER
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DiagnosisStatus {
  PENDING
  ANSWERED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      Role
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Shared location fields
  region String?
  town   String?

  // Farmer-specific
  farmingType String?
  farmSize    String?
  twoFactor   Boolean @default(false)
  iotInterest Boolean @default(false)
  idFrontUrl    String?
  idBackUrl     String?
  farmProofUrl  String?

  // TWO-FACTOR AUTHENTICATION FIELDS
  twoFactorEnabled   Boolean  @default(false)
  twoFactorSecret    String?
  twoFactorBackupCodes String?
  twoFactorVerified  Boolean  @default(false)

  // Buyer-specific
  interests String[] @default([])

  // Agronomist-specific
  specialization    String?
  experience        String?
  institution       String?
  certificationUrl  String?

  // Admin-specific
  position      String?
  organization  String?
  inviteCode    String?
  authLetterUrl String?

  // Account status
  verified  Boolean @default(true)
  suspended Boolean @default(false)

  // Relations
  listings Listing[]
  devices  Device[]
  orders   Order[]  @relation("BuyerOrders")
  alerts   Alert[]
  notifications Notification[]  // ← ADD THIS LINE

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  consultationsAsFarmer     Consultation[] @relation("FarmerConsultations")
  consultationsAsAgronomist Consultation[] @relation("AgronomistConsultations")
  diagnosesAsFarmer         Diagnosis[]    @relation("FarmerDiagnoses")
  diagnosesAsAgronomist     Diagnosis[]    @relation("AgronomistDiagnoses")
  articles                  Article[]
  farms                     Farm[]
}

model Listing {
  id          Int           @id @default(autoincrement())
  title       String
  category    String
  description String
  price       Int
  unit        String
  quantity    String
  imageUrl    String?
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  farmer   User @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmerId Int

  orders Order[]
}

model Order {
  id           Int         @id @default(autoincrement())
  quantity     Int
  totalPrice   Int
  status       OrderStatus @default(PENDING)
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int

  buyer   User @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId Int
}

model Device {
  id            Int        @id @default(autoincrement())
  name          String
  type          DeviceType
  location      String?
  farmId        Int?
  active        Boolean    @default(true)
  deviceKey     String     @unique
  lastReading   DateTime?
  minThreshold  Float?
  maxThreshold  Float?
  alertEnabled  Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  farmer   User @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmerId Int
  farm     Farm? @relation(fields: [farmId], references: [id])

  readings Reading[]
  alerts   Alert[]
}

model Reading {
  id          Int        @id @default(autoincrement())
  value       Float
  unit        String
  type        ReadingType
  timestamp   DateTime   @default(now())
  latitude    Float?
  longitude   Float?

  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId Int

  @@index([deviceId, timestamp])
  @@index([timestamp])
}

model Alert {
  id          Int      @id @default(autoincrement())
  message     String
  severity    String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId Int
  farmer   User   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmerId Int
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  sender     User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   Int
  receiver   User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId Int

  @@index([senderId, receiverId])
}

model Consultation {
  id          Int                @id @default(autoincrement())
  subject     String
  notes       String?
  status      ConsultationStatus @default(PENDING)
  scheduledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  farmer       User @relation("FarmerConsultations", fields: [farmerId], references: [id], onDelete: Cascade)
  farmerId     Int
  agronomist   User? @relation("AgronomistConsultations", fields: [agronomistId], references: [id], onDelete: SetNull)
  agronomistId Int?
}

model Diagnosis {
  id            Int             @id @default(autoincrement())
  cropName      String
  description   String
  imageUrl      String?
  voiceNoteUrl  String?
  response      String?
  aiSuggestion  String?
  status        DiagnosisStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  farmer       User  @relation("FarmerDiagnoses", fields: [farmerId], references: [id], onDelete: Cascade)
  farmerId     Int
  agronomist   User? @relation("AgronomistDiagnoses", fields: [agronomistId], references: [id], onDelete: SetNull)
  agronomistId Int?
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId Int
}

model Farm {
  id          Int      @id @default(autoincrement())
  name        String
  farmingType String
  size        String?
  region      String?
  town        String?
  description String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmer   User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmerId Int
  devices  Device[]
}

model PlatformSettings {
  id                  Int      @id @default(1)
  siteName            String   @default("AGRINOVA")
  supportEmail        String?
  supportPhone        String?
  allowRegistrations  Boolean  @default(true)
  requireVerification Boolean  @default(true)
  maintenanceMode     Boolean  @default(false)
  announcement        String?
  updatedAt           DateTime @updatedAt
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([token])
}

// ✅ ADD THIS MODEL
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("info")
  link      String?
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}
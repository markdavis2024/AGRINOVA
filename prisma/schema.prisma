generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============
enum Role {
  FARMER
  BUYER
  AGRONOMIST
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ConsultType {
  VIDEO
  PHONE
  IN_PERSON
}

enum ConsultStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum DiagnosisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum CredentialStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============ USER ============
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String?
  phone            String?
  role             Role
  region           String?
  town             String?
  photoUrl         String?
  verified         Boolean  @default(false)
  emailVerified    Boolean  @default(false)
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  iotInterest      Boolean  @default(false)

  farmer       Farmer?
  buyer        Buyer?
  agronomist   Agronomist?
  sentMessages Message[]  @relation("SentMessages")
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([email])
}

// ============ ROLE PROFILES ============
model Farmer {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmingType  String?
  farmSize     String?
  idFrontUrl   String?
  idBackUrl    String?
  farmProofUrl String?

  listings      Listing[]
  orders        Order[]        @relation("FarmerOrders")
  devices       Device[]
  consultations Consultation[]
  diagnoses     Diagnosis[]
  savedBy       SavedFarmer[]

  createdAt DateTime @default(now())
}

model Buyer {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String?
  companyType       String?
  preferredProducts String[]

  orders       Order[]       @relation("BuyerOrders")
  savedFarmers SavedFarmer[]

  createdAt DateTime @default(now())
}

model Agronomist {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  String?
  experience      String?
  institution     String?
  certificateUrl  String?
  credentialStatus CredentialStatus @default(PENDING)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  pricePerSession Int      @default(0)
  languages       String[]
  bio             String?

  consultations Consultation[]
  diagnoses     Diagnosis[]
  articles      Article[]

  createdAt DateTime @default(now())
}

// ============ MARKETPLACE ============
model Listing {
  id          String   @id @default(cuid())
  farmerId    String
  farmer      Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name        String
  category    String
  price       Float
  unit        String   @default("kg")
  quantity    Int
  imageUrl    String?
  description String?
  available   Boolean  @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([available])
}

model Order {
  id           String      @id @default(cuid())
  buyerId      String
  buyer        Buyer       @relation("BuyerOrders", fields: [buyerId], references: [id])
  farmerId     String
  farmer       Farmer      @relation("FarmerOrders", fields: [farmerId], references: [id])
  listingId    String
  listing      Listing     @relation(fields: [listingId], references: [id])
  quantity     Int
  totalPrice   Float
  status       OrderStatus @default(PENDING)
  deliveryType String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model SavedFarmer {
  id       String @id @default(cuid())
  buyerId  String
  buyer    Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@unique([buyerId, farmerId])
}

// ============ AGRONOMY ============
model Consultation {
  id           String        @id @default(cuid())
  farmerId     String
  farmer       Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  agronomistId String?
  agronomist   Agronomist?   @relation(fields: [agronomistId], references: [id])
  date         DateTime
  time         String
  type         ConsultType
  status       ConsultStatus @default(PENDING)
  notes        String?
  price        Float         @default(0)

  createdAt DateTime @default(now())

  @@index([status])
}

model Diagnosis {
  id           String          @id @default(cuid())
  farmerId     String
  farmer       Farmer          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  agronomistId String?
  agronomist   Agronomist?     @relation(fields: [agronomistId], references: [id])
  crop         String
  issue        String
  images       String[]
  priority     Priority        @default(MEDIUM)
  status       DiagnosisStatus @default(PENDING)
  reply        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Article {
  id        String     @id @default(cuid())
  authorId  String
  author    Agronomist @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  category  String
  excerpt   String
  content   String
  published Boolean    @default(false)
  views     Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// ============ IOT ============
model Device {
  id        String   @id @default(cuid())
  farmerId  String
  farmer    Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name      String
  type      String
  active    Boolean  @default(true)
  lastReading Json?

  createdAt DateTime @default(now())
}

// ============ MESSAGING ============
model Conversation {
  id           String    @id @default(cuid())
  participantA String
  participantB String
  lastMessage  String?
  lastAt       DateTime?

  messages Message[]

  createdAt DateTime @default(now())

  @@unique([participantA, participantB])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  read           Boolean      @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId])
}

// ============ NOTIFICATIONS & SETTINGS ============
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

model PlatformSettings {
  id                  Int     @id @default(1)
  siteName            String  @default("AGRINOVA")
  supportEmail        String?
  allowRegistrations  Boolean @default(true)
  requireVerification Boolean @default(true)
  maintenanceMode     Boolean @default(false)
  announcement        String?
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())
}